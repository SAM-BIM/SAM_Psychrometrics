<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Rhino.Testing loads the real, installed Rhino 8 + Grasshopper runtime in-process
         (see Rhino.Testing.Configs.xml); the NuGet copies are compile-time references only. -->
    <ShouldRemoveRhinoReferences>True</ShouldRemoveRhinoReferences>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grasshopper" Version="8.21.25188.17001" Private="False" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="RhinoCommon" Version="8.21.25188.17001" Private="False" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="Rhino.Testing" Version="8.0.28-beta" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SAM.Core.Grasshopper.Psychrometrics\SAM.Core.Grasshopper.Psychrometrics.csproj" />
    <Reference Include="SAM.Core.Grasshopper">
      <HintPath>..\..\..\SAM\build\SAM.Core.Grasshopper.dll</HintPath>
    </Reference>
    <!-- The updater's Log/LogRecord and the ParameterRename types the component declares live in SAM.Core. -->
    <Reference Include="SAM.Core">
      <HintPath>..\..\..\SAM\build\SAM.Core.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="Rhino.Testing.Configs.xml" CopyToOutputDirectory="Always" />
    <None Update="Fixtures\**\*.ghx" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
